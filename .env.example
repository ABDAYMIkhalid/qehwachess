# Qehwa Chess — example environment variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never commit .env. Never put the Supabase service-role key here —
# the frontend only needs the anon (public) key.

# Supabase project URL
# Find it at: Supabase Dashboard → your project → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / public key
# Find it at: Supabase Dashboard → your project → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here
